---
import Base from '../../layouts/Base.astro';
import TopBar from '../../components/TopBar.astro';
import Photo from '../../components/Photo.astro';
import LogHeader from '../../components/LogHeader.astro';
import LogSection from '../../components/LogSection.astro';
import NextProject from '../../components/NextProject.astro';

const features = [
  { t: 'Summaries', d: 'Upload course files, get the key points back.' },
  { t: 'Priorities', d: 'Which papers and assessments to do first — harder ones weighted higher.' },
  { t: 'Scheduling', d: 'A chat assistant that connects to Google Calendar and books the work in.' },
  { t: 'Phone → laptop', d: 'Drop files in on your phone, open the results on your laptop with a code.' },
];

const stack = [
  { box: 'App', strong: true }, { link: 'auth' }, { box: 'Supabase' }, { link: 'files' },
  { box: 'AI model · [WHICH]' }, { link: 'tasks' }, { box: 'Google Calendar' },
];

// Build log — newest first. status: 'now' | 'next' | 'later' | 'done'
const log = [
  { status: 'now', when: '[DATE]', title: 'Visual shell — screens, buttons, logo and fonts', note: '[Write: what you built this week.]' },
  { status: 'next', title: 'Login with Supabase' },
  { status: 'next', title: 'File upload and AI summaries' },
  { status: 'later', title: 'Priorities and Google Calendar scheduling' },
  { status: 'later', title: 'Phone-to-laptop handoff' },
  { status: 'later', title: 'Testing with friends and fixing what they find' },
];

const screens = [
  { id: 's1', label: '[HOME]', caption: 'Home', aspect: '9 / 16' },
  { id: 's2', label: '[UPLOAD]', caption: 'Upload course files', aspect: '9 / 18' },
  { id: 's3', label: '[SUMMARY]', caption: 'Key-point summary', aspect: '9 / 18' },
  { id: 's4', label: '[SCHEDULE]', caption: 'Scheduling to Google Calendar', aspect: '9 / 16' },
];
---
<Base title="Tandem — build log · John Rhey Chanas" description="Building Tandem, a study assistant that summarises course files, prioritises assessments and schedules the work." narrow progress>
  <TopBar back />

  <LogHeader
    kicker="Build log / Mobile app"
    title="Tandem"
    status="In progress"
    intro="A study assistant for uni students. Drop in your course files, get the key points back, know which assessment to tackle first — and have the work booked into your calendar."
    meta={[
      { label: 'Started', value: '[MONTH 2026]' },
      { label: 'Stack', value: 'Expo · Supabase' },
      { label: 'Role', value: 'Design & development' },
      { label: 'Stage', value: 'UI shell' },
    ]}
  />

  <div class="card fade d2" style="padding:clamp(18px,3vw,28px) clamp(18px,3vw,28px) 0;overflow:hidden">
    <div style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(8px,1.6vw,16px);align-items:end">
      {screens.map((s) => (
        <Photo id={s.id} group="tandem" label={s.label} caption={s.caption} aspect={s.aspect} style="border-radius:20px 20px 0 0;border-bottom:0" />
      ))}
    </div>
  </div>

  <LogSection n="01" title="The problem">
    <p class="prose">[Write: what a busy week of uni actually looks like, and why existing tools didn’t fix it for you.]</p>
  </LogSection>

  <LogSection n="02" title="What it does">
    <div class="grid-auto" style="--min:220px">
      {features.map((f) => (
        <div style="padding:18px;border-radius:16px;background:var(--chip);border:1px solid var(--line);display:flex;flex-direction:column;gap:8px">
          <span style="font-size:15.5px;font-weight:600">{f.t}</span>
          <span class="ink2" style="font-size:14px;line-height:1.55">{f.d}</span>
        </div>
      ))}
    </div>
  </LogSection>

  <LogSection n="03" title="How it’s built">
    <p class="prose">An Expo / React Native app with Supabase handling login. The AI runs on an existing model rather than one I trained — my work is the product around it. [Add which model and why.]</p>
    <div style="display:flex;flex-wrap:wrap;align-items:center;gap:10px;padding:22px;border-radius:16px;background:var(--chip);border:1px solid var(--line)">
      {stack.map((s, i) => s.box ? (
        <span class="mono" style={s.strong
          ? 'padding:12px 14px;border-radius:10px;background:var(--ink);color:var(--inv);font-size:12.5px'
          : 'padding:12px 14px;border-radius:10px;background:var(--card);border:1px solid var(--line);font-size:12.5px'}>{s.box}</span>
      ) : (
        <span style="flex:1 1 40px;min-width:32px;display:flex;flex-direction:column;align-items:center;gap:4px">
          <span class="mono muted" style="font-size:10.5px">{s.link}</span>
          <span style="position:relative;display:block;width:100%;height:1px;background:var(--line2)">
            <span class="flow" style={`animation-delay:${(i - 1) * 0.3}s`}></span>
          </span>
        </span>
      ))}
    </div>
  </LogSection>

  <LogSection n="04" title="Build log">
    <div style="position:relative">
      <span class="rvv" aria-hidden="true" style="position:absolute;left:5px;top:6px;bottom:6px;width:1px;background:var(--line2)"></span>
      <ol style="margin:0;padding:0 0 0 28px;list-style:none;display:flex;flex-direction:column;gap:22px">
        {log.map((e) => (
          <li style="position:relative;display:flex;flex-direction:column;gap:4px">
            <span aria-hidden="true" class:list={{ pulse: e.status === 'now' }} style={e.status === 'now' || e.status === 'done'
              ? 'position:absolute;left:-28px;top:4px;width:11px;height:11px;border-radius:50%;background:var(--acc)'
              : 'position:absolute;left:-28px;top:4px;width:11px;height:11px;border-radius:50%;border:1.5px solid var(--line2);background:var(--card)'}></span>
            <span class="mono" style={`font-size:11px;color:${e.status === 'now' ? 'var(--acc-t)' : 'var(--muted)'}`}>
              {e.status.toUpperCase()}{e.when && ` · ${e.when}`}
            </span>
            <span style="font-size:16px;font-weight:500">{e.title}</span>
            {e.note && <span class="ink2" style="font-size:14px">{e.note}</span>}
          </li>
        ))}
      </ol>
    </div>
  </LogSection>

  <LogSection n="05" title="Design decisions">
    <p class="prose">I didn’t want Tandem to look like another generic AI app, so I went with a light background and kept the accent and dark colours sparing. [Add what you explored and dropped.]</p>
    <div class="grid-auto" style="--min:260px">
      <div style="display:flex;flex-direction:column;gap:8px">
        <Photo id="before" group="tandem" label="[EARLY CONCEPT]" caption="Before — early concept" style="border-radius:14px" />
        <span class="mono muted" style="font-size:11px">BEFORE</span>
      </div>
      <div style="display:flex;flex-direction:column;gap:8px">
        <Photo id="after" group="tandem" label="[CURRENT DESIGN]" caption="Now — light UI, sparing accents" style="border-radius:14px" />
        <span class="mono" style="font-size:11px;color:var(--acc-t)">NOW</span>
      </div>
    </div>
  </LogSection>

  <NextProject href="/projects/self-balancing-robot" title="Self-Balancing Robot" />
</Base>
